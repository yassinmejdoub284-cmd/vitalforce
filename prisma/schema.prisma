generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id               String      @id @default(cuid())
  name             String
  slug             String      @unique
  subtitle         String
  sku              String      @unique
  price            Float
  compareAtPrice   Float?
  stock            Int         @default(0)
  flavor           String
  netWeight        String
  image            String
  shortDescription String
  active           Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  orderItems       OrderItem[]
}

model Order {
  id            String      @id @default(cuid())
  number        String      @unique
  customerName  String
  phone         String
  email         String?
  address       String
  city          String
  note          String?
  status        String      @default("new")
  paymentMethod String
  paymentStatus String      @default("pending")
  paymentRef    String?
  deliveryCompany String    @default("local_courier")
  shippingStatus  String    @default("pending")
  trackingNumber  String?
  subtotal      Float
  deliveryFee   Float
  discount      Float       @default(0)
  total         Float
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  name      String
  price     Float
  quantity  Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model Coupon {
  id          String   @id @default(cuid())
  code        String   @unique
  description String
  percentOff  Int
  active      Boolean  @default(true)
  startsAt    DateTime @default(now())
  endsAt      DateTime?
  createdAt   DateTime @default(now())
}

model SiteSetting {
  id                    String @id @default("site")
  siteName              String @default("VITAL FORCE")
  phone                 String @default("+216 27 200 603")
  address               String @default("Sfax, Tunisie")
  deliveryFee           Float  @default(7)
  freeShippingThreshold Float  @default(180)
  updatedAt             DateTime @updatedAt
}
