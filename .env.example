# --- Base de données (obligatoire) ---
# PostgreSQL: Neon (intégration Vercel), Supabase ou tout Postgres. Utilisez l'URL « pooled » pour DATABASE_URL.
DATABASE_URL="postgres://user:password@host/vitalforce?sslmode=require"
# Optionnel: URL directe (non poolée) utilisée pour les migrations au déploiement.
DATABASE_URL_UNPOOLED=""

# --- Admin (obligatoire) ---
# Clé secrète des sessions: 32 caractères minimum (ex: openssl rand -base64 48).
AUTH_SECRET=""
# Premier compte admin, créé automatiquement à la première connexion (10 caractères minimum).
ADMIN_EMAIL="admin@vitalforce-bioactive.com"
ADMIN_PASSWORD=""
# Sous-domaine de l'admin. Sur le domaine public, /admin redirige vers ce sous-domaine.
ADMIN_HOST="admin.vitalforce-bioactive.com"

# --- Site ---
NEXT_PUBLIC_SITE_URL="https://vitalforce-bioactive.com"

# --- Notifications push (application admin) ---
# Générer avec: npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@vitalforce-bioactive.com"

# --- Tâche planifiée Vercel (suivi Jetpack + dépenses Meta) ---
CRON_SECRET=""

# --- Valeurs par défaut (facultatif: tout se règle aussi dans Admin → Gestion du site) ---
JETPACK_ADD_TOKEN=""
JETPACK_TRACK_TOKEN=""
NEXT_PUBLIC_META_PIXEL_ID=""
META_CONVERSIONS_API_TOKEN=""
META_TEST_EVENT_CODE=""
META_AD_ACCOUNT_ID=""
META_MARKETING_TOKEN=""
